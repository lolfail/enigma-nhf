@startuml
hide empty members
skinparam defaultFontName Fira Code

class EnigmaMachine
class RotorCompartment <<List<Rotor>>>
class Rotor

class reflector <<SelfMap>>
class plugboard <<SelfMap>>
class wiring <<PairMap>>

EnigmaMachine *-- RotorCompartment
RotorCompartment "one " *-- "many" Rotor
Rotor ..> Rotor

EnigmaMachine *-- plugboard
RotorCompartment *-- reflector
Rotor *-- wiring

@enduml
