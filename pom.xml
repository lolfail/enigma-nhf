<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>enigma</groupId>
  <artifactId>enigma</artifactId>
  <name>enigma</name>
  <version>0</version>

  <build>
    <plugins>

      <plugin>
        <!-- execute make all to build docs -->

        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>

        <configuration>
          <!-- mainClass type configuration failed to pass environment variables so it is now direct java invokation -->
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>Main</argument>
          </arguments>

          <!-- wayland does not seem to like swing... -->
          <environmentVariables>
            <_JAVA_AWT_WM_NONREPARENTING>1</_JAVA_AWT_WM_NONREPARENTING>
            <GDK_BACKEND>x11</GDK_BACKEND>
          </environmentVariables>
        </configuration>

        <executions>
          <!-- mvn exec:exec@build-docs -->
          <execution>
            <id>build-docs</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>make</executable>
              <arguments>
                <argument>all</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- run ja(va)co(de)co(verage) -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>

        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>

          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- mvn package: java -jar target/enigma-0.jar -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
